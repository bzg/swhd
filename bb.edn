{;; the daemon itself, with its deps.edn dependencies
 :deps {io.github.bzg/swhd {:local/root "."}}
 :bbin/bin {swhd {:main-opts ["-m" "swhd.core"]}}
 :tasks
 {daemon
  {:doc "Run the daemon (SWHD_PORT, SWH_API_TOKEN)"
   :task (exec 'swhd.core/-main)}
  test
  {:doc "Run the test suite"
   :extra-paths ["test"]
   :requires ([clojure.test :as t])
   :task (do
           (require 'swhd.cache-test 'swhd.origin-test 'swhd.scan-test 'swhd.core-test)
           (let [{:keys [fail error]}
                 (t/run-tests 'swhd.cache-test 'swhd.origin-test
                              'swhd.scan-test 'swhd.core-test)]
             (System/exit (if (pos? (+ fail error)) 1 0))))}}}
